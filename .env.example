# Copy this file to .env (same folder) and fill in the values. .env is git-ignored — never commit it.
# On Render, add the same names under Service -> Environment instead.

# Free key from https://aistudio.google.com/apikey  (enables the AI voice receptionist)
GEMINI_API_KEY=

# Optional: which Google Calendar the clinic uses (share it with the service account, "Make changes to events")
GOOGLE_CALENDAR_ID=primary

# Optional voice settings
VOICE_MODEL=gemini-3.8-live
VOICE_NAME=Kore
